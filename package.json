{
  "name": "job-buddy",
  "private": true,
  "version": "0.3.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/start.ts",
    "start": "node --env-file-if-exists=.env.local --import tsx server/start.ts",
    "preview": "vite preview",
    "build": "tsc -b && vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "verify:client-secrets": "node --env-file-if-exists=.env.local scripts/verify-client-secrets.mjs dist",
    "check": "npm test && npm run typecheck && npm run build && npm run verify:client-secrets && npm run test:e2e",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "xlsx": "^0.18.5",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.5.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "latest",
    "tsx": "^4.23.13",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
